# =============================================================================
# YouTube Content Publisher — environment template
# =============================================================================
# Copy to `.env.local` for local development:
#     cp .env.example .env.local
#
# `.env.local` and `.env` are gitignored. NEVER commit real values.
# Every variable marked [SECRET] must be treated like a password: keep it out
# of chat, screenshots, tickets, logs and source control.
#
# See ENVIRONMENT_VARIABLES.md for the full reference.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. DATABASE  (required)
# -----------------------------------------------------------------------------
# PostgreSQL. With Supabase: Project Settings -> Database -> Connection string.
#
# DATABASE_URL  = the POOLED connection (pgBouncer, port 6543) used at runtime.
#                 Must include `?pgbouncer=true&connection_limit=1` on serverless.
# DIRECT_URL    = the DIRECT connection (port 5432) used by `prisma migrate`,
#                 which needs session-level features pgBouncer cannot proxy.
#
# [SECRET] both contain the database password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"


# -----------------------------------------------------------------------------
# 2. APPLICATION AUTH  (required)
# -----------------------------------------------------------------------------
# Public base URL of this app. No trailing slash.
# Local: http://localhost:3000   Production: https://your-domain.com
AUTH_URL="http://localhost:3000"

# [SECRET] Signs and encrypts session cookies. Generate a fresh one:
#     openssl rand -base64 32
# Rotating this logs everybody out. Use a DIFFERENT value per environment.
AUTH_SECRET=""

# [SECRET] Encrypts stored Google OAuth refresh/access tokens at rest
# (AES-256-GCM). Must be EXACTLY 32 bytes, base64-encoded. Generate:
#     openssl rand -base64 32
#
# !! LOSING THIS MAKES EVERY STORED GOOGLE TOKEN UNDECRYPTABLE.
# !! An admin would have to reconnect the Google account. Back it up.
# !! Must be DIFFERENT from AUTH_SECRET.
TOKEN_ENCRYPTION_KEY=""


# -----------------------------------------------------------------------------
# 3. GOOGLE OAUTH  (required)
# -----------------------------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials
# -> OAuth 2.0 Client ID (type: Web application).
# Full walkthrough: SETUP_GUIDE.md
#
# IMPORTANT: You need TWO separate OAuth clients:
#
# A. Identity-only client (for user sign-in):
#    - Scopes: openid email profile ONLY
#    - Redirect URIs: <AUTH_URL>/api/auth/callback/google
#    - Used for: Users signing into the app
#
# B. Publishing client (for YouTube/Drive integration):
#    - Scopes: https://www.googleapis.com/auth/youtube.upload
#              https://www.googleapis.com/auth/drive.file
#    - Redirect URIs: <AUTH_URL>/api/integrations/google/callback
#    - Used for: Publishing content to YouTube
#
# Identity client:
GOOGLE_CLIENT_ID=""
# [SECRET]
GOOGLE_CLIENT_SECRET=""
#
# Publishing client:
GOOGLE_PUBLISHING_CLIENT_ID=""
# [SECRET]
GOOGLE_PUBLISHING_CLIENT_SECRET=""


# -----------------------------------------------------------------------------
# 4. PUBLISHING SAFETY  (strongly recommended)
# -----------------------------------------------------------------------------
# Master kill-switch for real YouTube writes. When "false", the publishing
# engine refuses every remote write and records a clear error instead.
# Keep this "false" in development so a stray click can never hit the real
# channel. The org-level "Enable production publishing" toggle is ALSO
# required — both must be on (Section 40).
PUBLISHING_ENABLED="false"

# Shown in the UI banner. One of: development | staging | production
APP_ENV="development"

# [SECRET] Shared secret the background worker / cron uses to authenticate to
# /api/jobs/tick. Generate: openssl rand -hex 32
WORKER_SECRET=""


# -----------------------------------------------------------------------------
# 5. OPTIONAL
# -----------------------------------------------------------------------------
# Bootstrap: the first user to sign in with this email becomes ADMIN of the
# seeded organization. Leave blank after initial setup.
BOOTSTRAP_ADMIN_EMAIL=""

# Organization created by `npm run db:seed`.
SEED_ORG_NAME="My Organization"
SEED_ORG_SLUG="default"

# Bytes moved from Drive -> YouTube per worker tick. Must be a multiple of
# 262144 (256 KiB) — a Google requirement for resumable chunks.
# 64 MiB default: comfortably finishes inside a 300s serverless invocation.
RELAY_CHUNK_BYTES="67108864"

# Log verbosity: debug | info | warn | error
LOG_LEVEL="info"
